{
  "name": "@cardtable/state-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic In-Between state engine. Pure functions: deriveState, applyAction, getLegalActions, replay.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@cardtable/crypto-cards": "workspace:*",
    "@cardtable/protocol-types": "workspace:*",
    "@cardtable/script-templates": "workspace:*"
  },
  "devDependencies": {
    "@noble/secp256k1": "^2.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
