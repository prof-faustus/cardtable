{
  "name": "@cardtable/script-templates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BSV Script template builders for cardtable: stake-lock, pot-lock, card-custody, fold-surrender, reveal-proof, settlement, recovery, timeout-branch, round-state, table-root, entropy-commit.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cardtable/protocol-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
