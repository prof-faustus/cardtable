{
  "name": "@cardtable/tx-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical BSV transaction encoder + ECDSA sighash signer. Pure functions over (inputs, outputs, scripts, keys) producing the exact bytes BSV consensus accepts. No SDK dependency.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@cardtable/protocol-types": "workspace:*",
    "@noble/secp256k1": "^2.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
