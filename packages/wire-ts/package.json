{
  "name": "@cardtable/wire-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Binary frame codec for the cardtable wire protocol (TS mirror of apps/relay-go/pkg/wire).",
  "license": "MIT",
