{
  "name": "cardtable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dealerless distributed card-game protocol on BSV — monorepo root.",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*",
    "apps/client-web",
    "tools/transcript-verifier",
    "tools/transcript-recorder",
    "tests/integration"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"@cardtable/*\" build",
    "test": "pnpm -r --filter \"@cardtable/*\" test",
    "typecheck": "pnpm -r --filter \"@cardtable/*\" build",
    "lint": "pnpm -r --filter \"@cardtable/*\" lint",
    "ci": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "@types/node": "^20.12.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
