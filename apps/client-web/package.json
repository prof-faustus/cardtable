{
  "name": "@cardtable/client-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser client for the cardtable open-information prototype.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cardtable/protocol-types": "workspace:*",
    "@cardtable/state-engine": "workspace:*",
    "@cardtable/wire-ts": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "happy-dom": "^14.12.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
